FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY integrations/telegram/requirements.txt /app/requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt \
    && groupadd -g 1000 learnflix \
    && useradd -u 999 -g 1000 -M -s /usr/sbin/nologin learnflix \
    && mkdir -p /runtime \
    && chown 999:1000 /runtime
COPY dist/learnflix.cjs /app/dist/learnflix.cjs
COPY integrations/telegram /app/integrations/telegram
COPY deploy /app/deploy
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 999:1000
HEALTHCHECK --interval=30s --timeout=8s --start-period=90s --retries=3 CMD ["node", "deploy/health.cjs"]
CMD ["python3", "deploy/start.py"]
